# Get your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Port the server listens on
PORT=3000

# A secret you choose yourself — required to add/edit reference images.
# Generate one with: openssl rand -hex 16
ADMIN_KEY=choose-a-long-random-secret-here

# Optional: enables live reference-image lookup (searched at request time,
# held in memory only, never stored to disk). Set ONE of these two options.

# Option A — Bing Image Search (Azure Cognitive Services / Bing Search APIs)
BING_IMAGE_SEARCH_KEY=

# Option B — Google Custom Search JSON API
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

